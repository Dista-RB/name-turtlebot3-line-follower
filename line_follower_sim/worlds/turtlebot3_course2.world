      <static>1</static>
      <link name="ground">
        <collision name="ground_coll">
          <geometry>
            <box>
              <size>10 10 .01</size>
            </box>
          </geometry>
          <surface>
            <contact>
              <ode/>
            </contact>
          </surface>
        </collision>
        <visual name="ground_vis">
          <geometry>
            <box>
              <size>10 10 .01</size>
            </box>
          </geometry>
          <material>
            <script>
              <!--uri>file:///home/amorn/ros2_ws/src/turtlebot3_simulations/turtlebot3_gazebo/models/turtlebot3_course/course.material</uri-->
              <uri>model://turtlebot3_course/course.material</uri>
