        </geometry>
        <material>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name>
          </script>
          <ambient>1 1 1 1</ambient>
        </material>
        <meta>
          <layer>0</layer>
        </meta>
      </visual>
      <pose>0 5.925 0 0 -0 0</pose>
    </link>      
    <link name='Wall_2'>
      <collision name='Wall_2_Collision'>
        <geometry>
